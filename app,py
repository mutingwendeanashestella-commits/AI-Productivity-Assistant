import os
import streamlit as st
import google.generativeai as genai

# Page Configuration
st.set_page_config(page_title="Workplace AI Productivity Assistant", page_icon="🤖", layout="wide")

# API Setup
api_key = os.environ.get("GEMINI_API_KEY")
if not api_key:
    st.sidebar.error("⚠️ GEMINI_API_KEY environment variable not set.")
else:
    genai.configure(api_key=api_key)

# Header
st.title("🤖 Workplace AI Productivity Assistant")
st.markdown("Automating repetitive workplace tasks using Responsible AI practices.")

# Global Disclaimer (Responsible AI Requirement)
st.warning("⚠️ **Responsible AI Disclaimer:** This tool assists with workplace drafting and summarization. Always review, edit, and verify outputs before sending emails or finalizing meeting actions.")

st.divider()

# Navigation
option = st.sidebar.radio(
    "Select Assistant Feature:",
    ["1. Smart Email Generator", "2. Meeting Notes Summarizer", "3. AI Chatbot Interface"]
)

# Initialize Gemini Model
model = genai.GenerativeModel('gemini-1.5-flash')

# ==========================================
# FEATURE 1: SMART EMAIL GENERATOR
# ==========================================
if option == "1. Smart Email Generator":
    st.header("✉️ Smart Email Generator")
    st.write("Draft context-specific emails tailored by tone and target audience.")
    
    col1, col2 = st.columns(2)
    with col1:
        audience = st.selectbox("Target Audience", ["Client", "Manager", "Team Member", "Vendor"])
        tone = st.selectbox("Desired Tone", ["Formal", "Informal", "Persuasive", "Urgent"])
    with col2:
        subject_hint = st.text_input("Main Topic / Subject Line", "Project Status Update")
        key_points = st.text_area("Key Points to Cover", "Completed Milestone 1. Awaiting budget approval for Milestone 2. Need reply by Friday.")
    
    if st.button("Generate Email", type="primary"):
        # Prompt Engineering with Role, Constraints, and Clear Structure
        prompt = f"""
        Role: Executive Communications Specialist.
        Task: Draft a clear professional email based on the details below.
        
        Audience: {audience}
        Tone: {tone}
        Subject: {subject_hint}
        Key Points:
        {key_points}
        
        Formatting & Constraints:
        - Provide a concise Subject Line.
        - Add an appropriate greeting tailored for a {audience}.
        - Body must cover all key points smoothly.
        - Include a single clear Call To Action (CTA).
        - End with a professional sign-off.
        """
        
        with st.spinner("Drafting email..."):
            try:
                response = model.generate_content(prompt)
                st.success("Email Generated Successfully!")
                st.text_area("Generated Output", value=response.text, height=300)
            except Exception as e:
                st.error(f"Error generating email: {e}")

# ==========================================
# FEATURE 2: MEETING NOTES SUMMARIZER
# ==========================================
elif option == "2. Meeting Notes Summarizer":
    st.header("📝 Meeting Notes Summarizer")
    st.write("Convert raw meeting notes into structured key takeaways and action tables.")
    
    raw_notes = st.text_area("Paste Raw Meeting Notes / Transcript Here", height=200, placeholder="John: We finished the design phase. \nSarah: Great, I will handle frontend. Deadline is next Tuesday.")
    
    if st.button("Summarize & Extract Actions", type="primary"):
        if not raw_notes.strip():
            st.error("Please paste meeting notes before generating.")
        else:
            # Low Temperature / High Structure System Context Prompt
            prompt = f"""
            Role: Project Management Assistant.
            Task: Summarize the following meeting notes into structured Markdown.
            
            Meeting Notes:
            {raw_notes}
            
            Output Structure Requirements:
            1. Executive Summary: Maximum 2 sentences describing the main outcome.
            2. Key Decisions Made: Bullet points of major choices made.
            3. Action Item Matrix: Markdown Table with columns | Task | Assignee | Deadline |. If assignee/deadline is missing, mark as 'Unassigned' or 'TBD'.
            """
            
            with st.spinner("Analyzing transcript..."):
                try:
                    response = model.generate_content(prompt)
                    st.success("Summary Ready!")
                    st.markdown(response.text)
                except Exception as e:
                    st.error(f"Error processing notes: {e}")

# ==========================================
# FEATURE 3: AI CHATBOT INTERFACE
# ==========================================
elif option == "3. AI Chatbot Interface":
    st.header("💬 Interactive Workplace Assistant")
    st.write("Ask general questions, optimize tasks, or refine content interactively.")

    # Chat Memory Session State Initialization
    if "chat_messages" not in st.session_state:
        st.session_state.chat_messages = [
            {"role": "model", "parts": ["Hello! I am your workplace AI assistant. How can I help boost your productivity today?"]}
        ]

    # Display History
    for msg in st.session_state.chat_messages:
        role = "user" if msg["role"] == "user" else "assistant"
        with st.chat_message(role):
            st.markdown(msg["parts"][0])

    # User Input
    if user_input := st.chat_input("Ask a question or request administrative help..."):
        # Store User Message
        st.session_state.chat_messages.append({"role": "user", "parts": [user_input]})
        with st.chat_message("user"):
            st.markdown(user_input)

        # Generate Chat Response
        with st.chat_message("assistant"):
            with st.spinner("Thinking..."):
                try:
                    chat = model.start_chat(history=[
                        {"role": m["role"], "parts": m["parts"]} 
                        for m in st.session_state.chat_messages[:-1]
                    ])
                    response = chat.send_message(user_input)
                    st.markdown(response.text)
                    st.session_state.chat_messages.append({"role": "model", "parts": [response.text]})
                except Exception as e:
                    st.error(f"Chat error: {e}")
